      "border",
      "accent",
      "radius",
      "shadow",
      "spacing",
      "type scale",
      "motion"
    ],
    "note": "Extract/freeze tokens before framework implementation so coding tools do not substitute default theme colors or typography."
  },
  "interactions": {
    "source": [
      "assets.html"
    ],
    "requiredStates": [
      "default",
      "hover",
      "focus",
      "active",
      "disabled",
      "loading",
      "empty",
      "error",
      "success"
    ],
